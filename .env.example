# Preferred: the browser-safe Metered endpoint shown for a TURN credential.
# Example format: https://YOUR-APP.metered.live/api/v1/turn/credentials?apiKey=YOUR_CREDENTIAL_API_KEY
NEXT_PUBLIC_METERED_TURN_CREDENTIALS_URL=

# Alternative: a static TURN server. Set all three values together.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
